{
  "$schema": "https://schema.tauri.app/config/2",

  "identifier": "com.fi.moneyoverlay",
  "productName": "FI Money Overlay",
  "version": "1.0.0",

  "build": {
    "frontendDist": "../src",
    "devUrl": "tauri://localhost"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FI Money Overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "width": 400,
        "height": 200
      }
    ]
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}

